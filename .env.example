# Local catalog database
DATABASE_PATH=./data/roblox-games.db
SYNTHETIC_SEED=20261121

# Turso sync (required only when running `pnpm db:sync` or `pnpm db:ingest -- --sync`)
TURSO_DATABASE_URL=libsql://discover-weluvabid.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=

# API server
RANKING_WORKERS=4
RANKING_QUEUE_CAPACITY=128
HOST=127.0.0.1
PORT=8787
CORS_ORIGIN=http://localhost:4321

# Public frontend API origin (include /api). Leave empty for same-origin production routing.
PUBLIC_DISCOVER_API_URL=
