---
import '../styles/index.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Discover — Find your next world',
  description = 'Personalized Roblox experience discovery, powered by explainable recommendations.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090906" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
