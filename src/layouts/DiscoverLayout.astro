---
import '../styles/index.css';
import 'sonner/dist/styles.css';
import { ClientRouter } from 'astro:transitions';
import ToastHost from '@/components/react/ToastHost';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Discover — Find your next world',
  description = 'Personalized Roblox experience discovery, powered by explainable recommendations.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark h-full overflow-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0B0F" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="h-full overflow-y-auto scroll-smooth">
    <ToastHost client:load transition:persist="discover-toast-host" />
    <slot />
  </body>
</html>
