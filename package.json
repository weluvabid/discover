{
  "name": "discover",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "benchmark:ranking": "node --experimental-strip-types scripts/benchmark-ranking.mjs",
    "build": "pnpm build:web && pnpm api:build",
    "build:web": "node scripts/sync-brand-assets.mjs && astro check && astro build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:boundaries && pnpm test && pnpm build",
    "dev": "node scripts/sync-brand-assets.mjs && astro dev --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:reui": "sh ./scripts/install-reui.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "precommit": "pnpm check",
    "prepare": "sh ./scripts/install-hooks.sh",
    "preview": "astro preview --host 0.0.0.0",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "typecheck": "astro check",
    "api:dev": "node scripts/dev-api.mjs",
    "api:start": "node --env-file-if-exists=.env dist-server/live-server.mjs",
    "api:build": "vite build --config vite.server.config.ts",
    "check:boundaries": "node scripts/check-server-boundaries.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "@icons-pack/react-simple-icons": "^13.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/react": "^7.1.9",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.4.13",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.8",
    "vite": "^8.3.8"
  }
}
